<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="6">
    <Name Value="codebot_explorer"/>
    <Type Value="DesignTime"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CompilerMessages>
          <IgnoredMessages idx5024="True"/>
        </CompilerMessages>
      </Other>
    </CompilerOptions>
    <Files>
      <Item>
        <Filename Value="codebot.explorer.registration.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="Codebot.Explorer.Registration"/>
      </Item>
      <Item>
        <Filename Value="codebot.design.appexplorer.lfm"/>
        <Type Value="LFM"/>
      </Item>
      <Item>
        <Filename Value="codebot.design.appexplorer.pas"/>
        <UnitName Value="Codebot.Design.AppExplorer"/>
      </Item>
      <Item>
        <Filename Value="codebotexplorerpackage.pas"/>
        <Type Value="Main Unit"/>
        <UnitName Value="CodebotExplorerPackage"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="IDEIntf"/>
      </Item>
      <Item>
        <PackageName Value="RunTimeTypeInfoControls"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
