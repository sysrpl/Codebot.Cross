{ TSpaceBodyEnumerator }

class function TSpaceBodyEnumerator.Create(Space: cpSpace): TSpaceBodyEnumerator;
begin
  Result.FSpace := Space;
  Result.FIndex := 0;
  Result.FSleeping := nil;
  Result.FCurrent.Ref := nil;
end;

{ Bodies are kept in four lists. Dynamic bodies which are awake, static
  bodies, bodies woken while the space is locked, and sleeping components. A
  sleeping component is a root body followed by the other bodies in its
  group. }

function TSpaceBodyEnumerator.MoveNext: Boolean;
var
  I: Integer;
begin
  Result := True;
  if FSleeping <> nil then
  begin
    FSleeping := FSleeping.sleeping.next;
    if FSleeping <> nil then
    begin
      FCurrent.Ref := FSleeping;
      Exit;
    end;
  end;
  I := FIndex;
  Inc(FIndex);
  if I < FSpace.dynamicBodies.num then
  begin
    FCurrent.Ref := FSpace.dynamicBodies.arr[I];
    Exit;
  end;
  Dec(I, FSpace.dynamicBodies.num);
  if I < FSpace.staticBodies.num then
  begin
    FCurrent.Ref := FSpace.staticBodies.arr[I];
    Exit;
  end;
  Dec(I, FSpace.staticBodies.num);
  if I < FSpace.rousedBodies.num then
  begin
    FCurrent.Ref := FSpace.rousedBodies.arr[I];
    Exit;
  end;
  Dec(I, FSpace.rousedBodies.num);
  if I < FSpace.sleepingComponents.num then
  begin
    FSleeping := FSpace.sleepingComponents.arr[I];
    FCurrent.Ref := FSleeping;
    Exit;
  end;
  FCurrent.Ref := nil;
  Result := False;
end;

function TSpaceBodyEnumerator.GetEnumerator: TSpaceBodyEnumerator;
begin
  Result := Self;
end;

{ TSpaceShapeEnumerator }

class function TSpaceShapeEnumerator.Create(Space: cpSpace): TSpaceShapeEnumerator;
begin
  Result.FSpace := Space;
  Result.FBodies := TSpaceBodyEnumerator.Create(Space);
  Result.FGround := False;
  Result.FCurrent.Ref := nil;
end;

{ Every shape in a space is attached to a body in the space or to its ground
  body, which is not in the list of bodies }

function TSpaceShapeEnumerator.MoveNext: Boolean;
var
  B: cpBody;
begin
  if FCurrent.Ref <> nil then
    FCurrent.Ref := FCurrent.Ref.next;
  while FCurrent.Ref = nil do
  begin
    if not FGround then
    begin
      FGround := True;
      B := cpSpaceGetStaticBody(FSpace);
    end
    else if FBodies.MoveNext then
      B := FBodies.Current.Ref
    else
      Exit(False);
    FCurrent.Ref := B.shapeList;
  end;
  Result := True;
end;

function TSpaceShapeEnumerator.GetEnumerator: TSpaceShapeEnumerator;
begin
  Result := Self;
end;

{ TSpaceJointEnumerator }

class function TSpaceJointEnumerator.Create(Space: cpSpace): TSpaceJointEnumerator;
begin
  Result.FSpace := Space;
  Result.FIndex := 0;
  Result.FRoused := 0;
  Result.FComponent := 0;
  Result.FBody := nil;
  Result.FCurrent.Ref := nil;
end;

{ Move to the next body whose joints are not in the joints of the space, which
  are bodies woken while the space is locked followed by sleeping bodies }

function TSpaceJointEnumerator.NextHiddenBody: Boolean;
begin
  Result := True;
  { Walk the bodies of the current sleeping component }
  if (FBody <> nil) and (FRoused >= FSpace.rousedBodies.num) then
  begin
    FBody := FBody.sleeping.next;
    if FBody <> nil then
      Exit;
  end;
  if FRoused < FSpace.rousedBodies.num then
  begin
    FBody := FSpace.rousedBodies.arr[FRoused];
    Inc(FRoused);
    Exit;
  end;
  if FComponent < FSpace.sleepingComponents.num then
  begin
    FBody := FSpace.sleepingComponents.arr[FComponent];
    Inc(FComponent);
    Exit;
  end;
  FBody := nil;
  Result := False;
end;

{ When a body sleeps its joints are removed from the joints of the space and
  kept in the joint list of the body. A joint is removed by its first body, or
  by its second body if the first body is static. The same rule is used here
  so that each joint is found once. }

function TSpaceJointEnumerator.MoveNext: Boolean;
var
  C: cpConstraint;
begin
  if FIndex < FSpace.constraints.num then
  begin
    FCurrent.Ref := FSpace.constraints.arr[FIndex];
    Inc(FIndex);
    Exit(True);
  end;
  C := FCurrent.Ref;
  if (FIndex = FSpace.constraints.num) and (FBody = nil) then
    C := nil;
  repeat
    if C <> nil then
      if C.a = FBody then
        C := C.next_a
      else
        C := C.next_b;
    while C = nil do
    begin
      if not NextHiddenBody then
      begin
        FCurrent.Ref := nil;
        Exit(False);
      end;
      C := FBody.constraintList;
    end;
  until (C.a = FBody) or (cpBodyGetType(C.a) = CP_BODY_TYPE_STATIC);
  FCurrent.Ref := C;
  Result := True;
end;

function TSpaceJointEnumerator.GetEnumerator: TSpaceJointEnumerator;
begin
  Result := Self;
end;

{ Objects are released using post step callbacks, which run when the space
  unlocks at the end of each iteration. This removes each object from the space
  before it is freed, the same as the Chipmunk2D demos. }

procedure EachShapeFree(shape: cpShape; data: Pointer); cdecl;
begin
  cpSpaceAddPostStepCallback(data, PostShapeFree, shape, nil);
end;

procedure EachConstraintFree(constraint: cpConstraint; data: Pointer); cdecl;
begin
  cpSpaceAddPostStepCallback(data, PostConstraintFree, constraint, nil);
end;

procedure EachBodyFree(body: cpBody; data: Pointer); cdecl;
begin
  cpSpaceAddPostStepCallback(data, PostBodyFree, body, nil);
end;

{ Query callbacks which collect their results into lists }

type
  TShapeList = TArrayList<TShape>;
  PShapeList = ^TShapeList;
  TPointQueryList = TArrayList<cpPointQueryInfoStruct>;
  PPointQueryList = ^TPointQueryList;
  TSegmentQueryList = TArrayList<cpSegmentQueryInfoStruct>;
  PSegmentQueryList = ^TSegmentQueryList;

procedure PointQueryCollect(shape: cpShape; point: cpVect; distance: cpFloat; gradient: cpVect; data: Pointer); cdecl;
var
  Info: cpPointQueryInfoStruct;
begin
  Info.shape := shape;
  Info.point := point;
  Info.distance := distance;
  Info.gradient := gradient;
  PPointQueryList(data).Push(Info);
end;

procedure SegmentQueryCollect(shape: cpShape; point, normal: cpVect; alpha: cpFloat; data: Pointer); cdecl;
var
  Info: cpSegmentQueryInfoStruct;
begin
  Info.shape := shape;
  Info.point := point;
  Info.normal := normal;
  Info.alpha := alpha;
  PSegmentQueryList(data).Push(Info);
end;

procedure BoxQueryCollect(shape: cpShape; data: Pointer); cdecl;
var
  S: TShape;
begin
  S.Ref := shape;
  PShapeList(data).Push(S);
end;

procedure ShapeQueryCollect(shape: cpShape; points: cpContactPointSet; data: Pointer); cdecl;
var
  S: TShape;
begin
  S.Ref := shape;
  PShapeList(data).Push(S);
end;

{ TSpace }

class operator TSpace.Implicit(const Value: TSpace): cpSpace;
begin
  Result := Value.Ref;
end;

class operator TSpace.Implicit(const Value: cpSpace): TSpace;
begin
  Result.Ref := Value;
end;

procedure TSpace.Free;
begin
  if Ref = nil then
    Exit;
  ReleaseObjects;
  cpSpaceFree(Ref);
  Ref := nil;
end;

function TSpace.IsNil: Boolean;
begin
  Result := Ref = nil;
end;

procedure TSpace.ReleaseBodies;
var
  Items: TArrayList<TBody>;
  B: TBody;
  I: Integer;
begin
  for B in Bodies do
    Items.Push(B);
  for I := 0 to Items.Length - 1 do
    Items.Items[I].Free;
end;

procedure TSpace.ReleaseJoints;
var
  Items: TArrayList<TJoint>;
  J: TJoint;
  I: Integer;
begin
  for J in Joints do
    Items.Push(J);
  for I := 0 to Items.Length - 1 do
    Items.Items[I].Free;
end;

procedure TSpace.ReleaseObjects;
begin
  { Bodies woken while the space is locked are missed by cpSpaceEachBody, so
    wait until the space unlocks }
  if cpSpaceIsLocked(Ref) then
  begin
    cpSpaceAddPostStepCallback(Ref, PostReleaseObjects, Ref, nil);
    Exit;
  end;
  { The joints of sleeping bodies are not in the joints of the space, so wake
    every sleeping component first. Waking removes it from the list. }
  while Ref.sleepingComponents.num > 0 do
    cpBodyActivate(Ref.sleepingComponents.arr[0]);
  cpSpaceEachShape(Ref, EachShapeFree, Ref);
  cpSpaceEachConstraint(Ref, EachConstraintFree, Ref);
  cpSpaceEachBody(Ref, EachBodyFree, Ref);
end;

procedure TSpace.Step(DeltaTime: Float);
begin
  if DeltaTime > 0 then
    cpSpaceStep(Ref, DeltaTime);
end;

function TSpace.AddCollisionHandler(A, B: TCollisionType): TCollisionHandler;
begin
