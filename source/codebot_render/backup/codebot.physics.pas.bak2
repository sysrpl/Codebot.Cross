begin
  Result := A.Ref = B.Ref;
end;

class operator TJoint.NotEqual(const A, B: TJoint): Boolean;
begin
  Result := A.Ref <> B.Ref;
end;

procedure TJoint.Free;
begin
  if Ref = nil then
    Exit;
  if Ref.space = nil then
    cpConstraintFree(Ref)
  else if cpSpaceIsLocked(Ref.space) then
    cpSpaceAddPostStepCallback(Ref.space, PostConstraintFree, Ref, nil)
  else
    PostConstraintFree(Ref.space, Ref, nil);
  Ref := nil;
end;

function TJoint.IsNil: Boolean;
begin
  Result := Ref = nil;
end;

function TJoint.IsGrab: Boolean;

  function BodyIsGrab(Body: cpBody): Boolean;
  begin
    Result := (Body <> nil) and (Body.shapeList <> nil) and
      (cpShapeGetCollisionType(Body.shapeList) = collideGrab);
  end;

begin
  if IsNil then
    Exit(False);
  Result := BodyIsGrab(Ref.a) or BodyIsGrab(Ref.b);
end;

