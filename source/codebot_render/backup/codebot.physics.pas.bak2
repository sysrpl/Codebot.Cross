begin
  Result := A.Ref = B.Ref;
end;

class operator TShape.NotEqual(const A, B: TShape): Boolean;
begin
  Result := A.Ref <> B.Ref;
end;

procedure TShape.Free;
begin
  if Ref = nil then
    Exit;
  if Ref.space = nil then
    cpShapeFree(Ref)
  else if cpSpaceIsLocked(Ref.space) then
    cpSpaceAddPostStepCallback(Ref.space, PostShapeFree, Ref, nil)
  else
    { Removing a shape from its space also removes it from its body }
    PostShapeFree(Ref.space, Ref, nil);
  Ref := nil;
end;

