function TJoint.GetKind: TJointKind;
begin
  if cpConstraintIsPinJoint(Ref) then
    Result := jointPin
  else if cpConstraintIsSlideJoint(Ref) then
    Result := jointSlide
  else if cpConstraintIsPivotJoint(Ref) then
    Result := jointPivot
  else if cpConstraintIsGrooveJoint(Ref) then
    Result := jointGroove
  else if cpConstraintIsDampedSpring(Ref) then
    Result := jointDampedSpring
  else if cpConstraintIsDampedRotarySpring(Ref) then
    Result := jointDampedRotarySpring
  else if cpConstraintIsRotaryLimitJoint(Ref) then
    Result := jointRotaryLimit
  else if cpConstraintIsRatchetJoint(Ref) then
    Result := jointRatchet
  else if cpConstraintIsGearJoint(Ref) then
    Result := jointGear
  else if cpConstraintIsSimpleMotor(Ref) then
    Result := jointMotor
  else
    Result := jointCustom;
end;

