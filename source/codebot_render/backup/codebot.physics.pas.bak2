  Result := Shape;
end;

procedure TSpace.Remove(Body: TBody);
var
  Items: TArrayList<TShape>;
  S: TShape;
  I: Integer;
begin
  { Removing a shape unlinks it from the body, so collect the shapes first }
  for S in Body.Shapes do
    Items.Push(S);
  for I := 0 to Items.Length - 1 do
    cpSpaceRemoveShape(Ref, Items.Items[I].Ref);
  cpSpaceRemoveBody(Ref, Body.Ref);
end;

procedure TSpace.Remove(Joint: TJoint);
begin
  cpSpaceRemoveConstraint(Ref, Joint.Ref);
end;

procedure TSpace.Remove(Shape: TShape);
begin
