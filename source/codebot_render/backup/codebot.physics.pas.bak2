{ Polylines are allocated with the C runtime because Chipmunk2D frees and
  reallocates them }

function cpcalloc(count, size: PtrUInt): Pointer; cdecl; external name 'calloc';

function PolylineAlloc(Count: Integer): cpPolyline;
var
  Capacity: Integer;
begin
  Capacity := Count;
  if Capacity < 1 then
    Capacity := 1;
  Result := cpcalloc(1, SizeOf(Integer) * 2 + Capacity * SizeOf(TVec2));
  Result.count := Count;
  Result.capacity := Capacity;
end;

{ TPolyline }

class operator TPolyline.Implicit(const Value: TPolyline): cpPolyline;
begin
  Result := Value.Ref;
end;

class operator TPolyline.Implicit(const Value: cpPolyline): TPolyline;
begin
  Result.Ref := Value;
end;

class function TPolyline.Create(const Points: array of TVec2; Closed: Boolean = False): TPolyline;
var
  N, I: Integer;
  V: PVec2;
begin
  N := Length(Points);
  if Closed and (N > 1) and (Points[0] <> Points[N - 1]) then
    Result.Ref := PolylineAlloc(N + 1)
  else
    Result.Ref := PolylineAlloc(N);
  V := Result.Verts;
  for I := 0 to N - 1 do
    V[I] := Points[I];
  if Result.Ref.count > N then
    V[N] := Points[0];
end;

procedure TPolyline.Free;
begin
  if Ref <> nil then
    cpPolylineFree(Ref);
  Ref := nil;
end;

function TPolyline.IsNil: Boolean;
begin
  Result := Ref = nil;
end;

function TPolyline.Copy: TPolyline;
begin
  Result.Ref := PolylineAlloc(Count);
  if Count > 0 then
    Move(Verts^, Result.Verts^, Count * SizeOf(TVec2));
end;

{ The simplify functions of Chipmunk2D read past the vertices of polylines with
  too few vertices }

function TPolyline.SimplifyCurves(Tol: Float): TPolyline;
begin
  if Count < 3 then
    Result := Copy
  else
    Result.Ref := cpPolylineSimplifyCurves(Ref, Tol);
end;

function TPolyline.SimplifyVertexes(Tol: Float): TPolyline;
begin
  if Count < 3 then
    Result := Copy
  else
    Result.Ref := cpPolylineSimplifyVertexes(Ref, Tol);
end;

function TPolyline.ToConvexHull(Tol: Float = 0): TPolyline;
begin
  if Count < 1 then
    Result := Copy
  else
    Result.Ref := cpPolylineToConvexHull(Ref, Tol);
end;

function TPolyline.ToArray: TArray<TVec2>;
begin
  SetLength(Result, Count);
  if Count > 0 then
    Move(Verts^, Result[0], Count * SizeOf(TVec2));
end;

function TPolyline.GetCount: Integer;
begin
  if Ref = nil then
    Result := 0
  else
    Result := Ref.count;
end;

function TPolyline.GetVert(Index: Integer): TVec2;
begin
  Result := Verts[Index];
end;

function TPolyline.GetVerts: PVec2;
begin
  Result := @Ref.verts[0];
end;

function TPolyline.GetClosed: Boolean;
begin
  Result := (Ref <> nil) and cpPolylineIsClosed(Ref);
end;

{ TPolylineSetEnumerator }

class function TPolylineSetEnumerator.Create(PolylineSet: cpPolylineSet): TPolylineSetEnumerator;
begin
  Result.FSet := PolylineSet;
  Result.FIndex := 0;
  Result.FCurrent.Ref := nil;
end;

function TPolylineSetEnumerator.MoveNext: Boolean;
begin
  Result := (FSet <> nil) and (FIndex < FSet.count);
  if Result then
  begin
    FCurrent.Ref := FSet.lines[FIndex];
    Inc(FIndex);
  end
  else
    FCurrent.Ref := nil;
end;

{ March sampling with a method }

type
  TMarchSampleData = record
    Sample: TMarchSample;
  end;
  PMarchSampleData = ^TMarchSampleData;

function MarchSampleMethod(point: cpVect; data: Pointer): cpFloat; cdecl;
begin
  Result := PMarchSampleData(data)^.Sample(point);
end;

{ TPolylineSet }

class operator TPolylineSet.Implicit(const Value: TPolylineSet): cpPolylineSet;
begin
  Result := Value.Ref;
end;

class operator TPolylineSet.Implicit(const Value: cpPolylineSet): TPolylineSet;
begin
  Result.Ref := Value;
end;

class function TPolylineSet.Create: TPolylineSet;
begin
  Result.Ref := cpPolylineSetNew;
end;

{ Chipmunk2D requires a closed polygon with a positive area, but only checks
  this in debug builds }

class function TPolylineSet.ConvexDecomposition(Polyline: TPolyline; Tol: Float): TPolylineSet;
var
  L: TPolyline;
  V: PVec2;
  T: TVec2;
  I, J: Integer;
begin
  L := TPolyline.Create(Polyline.ToArray, True);
  try
    { A closed polygon needs at least three distinct vertices }
    if L.Count < 4 then
      Exit(Create);
    V := L.Verts;
    if cpAreaForPoly(L.Count, V, 0) < 0 then
    begin
      I := 0;
      J := L.Count - 1;
      while I < J do
      begin
        T := V[I];
        V[I] := V[J];
        V[J] := T;
        Inc(I);
        Dec(J);
      end;
    end;
    Result.Ref := cpPolylineConvexDecomposition(L.Ref, Tol);
  finally
    L.Free;
  end;
end;

{ Chipmunk2D loops forever with fewer than two samples in either direction }

class function TPolylineSet.MarchSoft(const Box: cpBB; XSamples, YSamples: Integer; Threshold: Float;
  Sample: cpMarchSampleFunc; Data: Pointer = nil): TPolylineSet;
begin
  Result.Ref := cpPolylineSetNew;
  if (XSamples < 2) or (YSamples < 2) or (not Assigned(Sample)) then
    Exit;
  cpMarchSoft(Box, XSamples, YSamples, Threshold, cpPolylineSetCollectSegment,
    Result.Ref, Sample, Data);
end;

class function TPolylineSet.MarchSoft(const Box: cpBB; XSamples, YSamples: Integer; Threshold: Float;
  Sample: TMarchSample): TPolylineSet;
var
  D: TMarchSampleData;
begin
  D.Sample := Sample;
  if Assigned(Sample) then
    Result := MarchSoft(Box, XSamples, YSamples, Threshold, MarchSampleMethod, @D)
  else
    Result := Create;
end;

class function TPolylineSet.MarchHard(const Box: cpBB; XSamples, YSamples: Integer; Threshold: Float;
  Sample: cpMarchSampleFunc; Data: Pointer = nil): TPolylineSet;
begin
  Result.Ref := cpPolylineSetNew;
  if (XSamples < 2) or (YSamples < 2) or (not Assigned(Sample)) then
    Exit;
  cpMarchHard(Box, XSamples, YSamples, Threshold, cpPolylineSetCollectSegment,
    Result.Ref, Sample, Data);
end;

class function TPolylineSet.MarchHard(const Box: cpBB; XSamples, YSamples: Integer; Threshold: Float;
  Sample: TMarchSample): TPolylineSet;
var
  D: TMarchSampleData;
begin
  D.Sample := Sample;
  if Assigned(Sample) then
    Result := MarchHard(Box, XSamples, YSamples, Threshold, MarchSampleMethod, @D)
  else
    Result := Create;
end;

procedure TPolylineSet.Free(FreeLines: Boolean = True);
begin
