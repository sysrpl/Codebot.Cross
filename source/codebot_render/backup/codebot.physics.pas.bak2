procedure TPolygon.Reshape(Verts: PVec2; Count: Integer; Transform: PMatrix2x3 = nil);
begin
  if Transform <> nil then
    cpPolyShapeSetVerts(Self, Count, Verts, Transform^)
  else
    cpPolyShapeSetVerts(Self, Count, Verts, MatrixIdentity);
end;

procedure TPolygon.Reshape(const Width, Height: Float; Transform: PMatrix2x3 = nil);
var
  V: array[0..3] of TVec2;
begin
  V[0].X := Width / -2; V[0].Y := Height / -2;
  V[1].X := V[0].X; V[1].Y := -V[0].Y;
  V[2].X := -V[0].X; V[2].Y := -V[0].Y;
  V[3].X := -V[0].X; V[3].Y := V[0].Y;
  Reshape(@V[0], 4, Transform);
end;

