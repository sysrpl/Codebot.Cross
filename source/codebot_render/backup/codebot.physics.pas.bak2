end;

function TSpace.NewPin(A, B: TBody; const PinA, PinB: TVec2): TJoint;
begin
  Result.Ref := cpSpaceAddConstraint(Ref, cpPinJointNew(A.Ref, B.Ref, PinA, PinB));
end;

function TSpace.NewSlide(A, B: TBody; const PinA, PinB: TVec2; Min, Max: Float): TJoint;
begin
  Result.Ref := cpSpaceAddConstraint(Ref, cpSlideJointNew(A.Ref, B.Ref, PinA, PinB, Min, Max));
end;

function TSpace.NewPivot(A, B: TBody; const Pivot: TVec2): TJoint;
begin
  Result.Ref := cpSpaceAddConstraint(Ref, cpPivotJointNew(A.Ref, B.Ref, Pivot));
end;

function TSpace.NewPivot(A, B: TBody; const PinA, PinB: TVec2): TJoint;
begin
  Result.Ref := cpSpaceAddConstraint(Ref, cpPivotJointNew2(A.Ref, B.Ref, PinA, PinB));
end;

function TSpace.NewGroove(A, B: TBody; const GrooveA, GrooveB, PinB: TVec2): TJoint;
begin
