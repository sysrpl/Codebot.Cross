{ TBodyShapeEnumerator }

class function TBodyShapeEnumerator.Create(Body: cpBody): TBodyShapeEnumerator;
begin
  Result.FBody := Body;
  Result.FStarted := False;
  Result.FCurrent.Ref := nil;
end;

function TBodyShapeEnumerator.MoveNext: Boolean;
begin
  if not FStarted then
  begin
    FStarted := True;
    if FBody <> nil then
      FCurrent.Ref := FBody.shapeList;
  end
  else if FCurrent.Ref <> nil then
    FCurrent.Ref := FCurrent.Ref.next;
  Result := FCurrent.Ref <> nil;
end;

function TBodyShapeEnumerator.GetEnumerator: TBodyShapeEnumerator;
begin
  Result := Self;
end;

{ TBody }

class operator TBody.Implicit(const Value: TBody): cpBody;
begin
  Result := Value.Ref;
end;

class operator TBody.Implicit(const Value: cpBody): TBody;
begin
  Result.Ref := Value;
end;

class operator TBody.Equal(const A, B: TBody): Boolean;
begin
  Result := A.Ref = B.Ref;
end;

class operator TBody.NotEqual(const A, B: TBody): Boolean;
begin
  Result := A.Ref <> B.Ref;
end;

procedure TBody.Free;
var
  Joints: TArrayList<TJoint>;
  Shapes: TArrayList<TShape>;
  Space: cpSpace;
  C: cpConstraint;
  J: TJoint;
  S: TShape;
  I: Integer;
begin
  if IsNil then
    Exit;
  Space := Ref.space;
  { The ground body belongs to its space }
  if (Space <> nil) and (Ref = cpSpaceGetStaticBody(Space)) then
    Exit;
  if (Space <> nil) and cpSpaceIsLocked(Space) then
  begin
    cpSpaceAddPostStepCallback(Space, PostBodyRelease, Ref, nil);
    Ref := nil;
    Exit;
  end;
  { Joints are only connected to a body while they are in a space }
  C := Ref.constraintList;
  while C <> nil do
  begin
    J.Ref := C;
    Joints.Push(J);
    if C.a = Ref then
      C := C.next_a
    else
      C := C.next_b;
  end;
  for I := 0 to Joints.Length - 1 do
    Joints.Items[I].Free;
  S.Ref := Ref.shapeList;
  while S.Ref <> nil do
  begin
    Shapes.Push(S);
    S.Ref := S.Ref.next;
  end;
  if Space <> nil then
  begin
    { Removing a shape from its space also removes it from its body }
    for I := 0 to Shapes.Length - 1 do
      cpSpaceRemoveShape(Space, Shapes.Items[I].Ref);
    cpSpaceRemoveBody(Space, Ref);
  end;
  for I := 0 to Shapes.Length - 1 do
    cpShapeFree(Shapes.Items[I].Ref);
  cpBodyFree(Ref);
  Ref := nil;
end;

function TBody.IsNil: Boolean;
begin
  Result := Ref = nil;
end;

function TBody.AddShape(Shape: cpShape): TShape;
begin
  if Ref.space <> nil then
    cpSpaceAddShape(Ref.space, Shape);
  cpShapeSetDensity(Shape, 1);
  Result.Ref := Shape;
end;

function TBody.NewCircle(Radius: Float): TShape;
begin
  Result := AddShape(cpCircleShapeNew(Ref, Radius, VectZero));
end;

function TBody.NewCircle(Radius: Float; const Offset: TVec2): TShape;
begin
  Result := AddShape(cpCircleShapeNew(Ref, Radius, Offset));
end;

function TBody.NewSegment(const A, B: TVec2; Border: Float = 0): TShape;
begin
  Result := AddShape(cpSegmentShapeNew(Ref, A, B, Border));
end;

function TBody.NewBox(Width, Height: Float; Border: Float = 0; Transform: PMatrix2x3 = nil): TShape;
var
  V: array[0..3] of TVec2;
begin
  V[0].X := Width / -2; V[0].Y := Height / -2;
  V[1].X := V[0].X; V[1].Y := -V[0].Y;
  V[2].X := -V[0].X; V[2].Y := -V[0].Y;
  V[3].X := -V[0].X; V[3].Y := V[0].Y;
  Result := NewPolygon(@V[0], 4, Border, Transform);
end;

function TBody.NewBox(X, Y, Width, Height: Float; Border: Float = 0; Transform: PMatrix2x3 = nil): TShape;
var
  V: array[0..3] of TVec2;
begin
  V[0].X := X - Width / 2; V[0].Y := Y - Height / 2;
  V[1].X := V[0].X; V[1].Y := V[0].Y + Height;
  V[2].X := V[0].X + Width; V[2].Y := V[0].Y + Height;
  V[3].X := V[0].X + Width; V[3].Y := V[0].Y;
  Result := NewPolygon(@V[0], 4, Border, Transform);
end;

function TBody.NewPolygon(Verts: PVec2; Count: Integer; Border: Float = 0; Transform: PMatrix2x3 = nil): TShape;
begin
  if Transform = nil then
    Result := AddShape(cpPolyShapeNew(Ref, Count, Verts, MatrixIdentity, Border))
  else
    Result := AddShape(cpPolyShapeNew(Ref, Count, Verts, Transform^, Border));
end;

{ Chipmunk2D aborts if a body is put to sleep when it is not dynamic, not in a
  space, the space is locked, or sleeping is not enabled on the space }

function CanSleep(Body: cpBody): Boolean;
begin
  Result := (Body <> nil) and (cpBodyGetType(Body) = CP_BODY_TYPE_DYNAMIC) and
    (Body.space <> nil) and (not cpSpaceIsLocked(Body.space)) and
    (cpSpaceGetSleepTimeThreshold(Body.space) < CP_INFINITY);
end;

procedure TBody.Sleep;
begin
  if CanSleep(Ref) then
    cpBodySleep(Ref);
end;

procedure TBody.SleepWithGroup(Body: TBody);
begin
  { The group must be a sleeping body }
  if CanSleep(Ref) and Body.IsSleeping then
    cpBodySleepWithGroup(Ref, Body.Ref);
end;

function TBody.IsSleeping: Boolean;
begin
  if Kind = bodyDynamic then
    Result := cpBodyIsSleeping(Ref)
  else
    Result := False;
end;

procedure TBody.WakeUp;
begin
  { Chipmunk2D aborts if cpBodyActivateStatic is called on a kinematic body }
  if Kind = bodyStatic then
    cpBodyActivateStatic(Ref, nil)
  else
    cpBodyActivate(Ref);
end;

