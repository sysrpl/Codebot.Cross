{ TBodyJointEnumerator }

class function TBodyJointEnumerator.Create(Body: cpBody): TBodyJointEnumerator;
begin
  Result.FBody := Body;
  Result.FStarted := False;
  Result.FCurrent.Ref := nil;
end;

function TBodyJointEnumerator.MoveNext: Boolean;
var
  C: cpConstraint;
begin
  if not FStarted then
  begin
    FStarted := True;
    if FBody <> nil then
      FCurrent.Ref := FBody.constraintList;
  end
  else if FCurrent.Ref <> nil then
  begin
    { Each joint is in the list of both its bodies }
    C := FCurrent.Ref;
    if C.a = FBody then
      FCurrent.Ref := C.next_a
    else
      FCurrent.Ref := C.next_b;
  end;
  Result := FCurrent.Ref <> nil;
end;

function TBodyJointEnumerator.GetEnumerator: TBodyJointEnumerator;
begin
  Result := Self;
end;

