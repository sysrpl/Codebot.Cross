function TSpace.AddPostStepCallback(Func: cpPostStepFunc; Key: Pointer; Data: Pointer = nil): Boolean;
begin
  Result := cpSpaceAddPostStepCallback(Ref, Func, Key, Data);
end;

function TSpace.NewBody: TBody;
begin
  Result.Ref := cpSpaceAddBody(Ref, cpBodyNew(0, 0));
end;

function TSpace.NewKinematicBody: TBody;
begin
