{ TWebInspector }

constructor TWebInspector.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  ControlStyle := ControlStyle - [csSetCaption];
  Width := 400;
  Height := 200;
end;

destructor TWebInspector.Destroy;
begin
  WebBrowser := nil;
  inherited Destroy;
end;

var
  InspectorRegistered: Boolean;

class procedure TWebInspector.WSRegisterClass;
begin
  if InspectorRegistered then
    Exit;
  InspectorRegistered := True;
  RegisterWSComponent(TWebInspector, TWSWebInspector);
end;

procedure TWebInspector.InitializeWnd;
begin
  inherited InitializeWnd;
  UpdateInspector;
end;

{ The inspector is closed before its window is destroyed, but remains active
  so it is shown again if the window is recreated }

procedure TWebInspector.DestroyWnd;
begin
  CloseInspector;
  FreeAndNil(FCanvas);
  inherited DestroyWnd;
end;

procedure TWebInspector.WMPaint(var Message: TLMPaint);
begin
  if (csDestroying in ComponentState) or (not HandleAllocated) then
    Exit;
  Include(FControlState, csCustomPaint);
  inherited WMPaint(Message);
  Exclude(FControlState, csCustomPaint);
end;

{ The control is only painted when it cannot host an inspector }

procedure TWebInspector.PaintWindow(DC: HDC);
var
  Changed: Boolean;
begin
  if (not (csDesigning in ComponentState)) and TCustomWebBrowser.Available then
    Exit;
  if FCanvas = nil then
  begin
    FCanvas := TControlCanvas.Create;
    FCanvas.Control := Self;
  end;
  Changed := (not FCanvas.HandleAllocated) or (FCanvas.Handle <> DC);
  if Changed then
    FCanvas.Handle := DC;
  Paint;
  if Changed then
    FCanvas.Handle := 0;
end;

procedure TWebInspector.Paint;
begin
  PaintLogo(FCanvas, ClientRect, 'Web Inspector', not (csDesigning in ComponentState));
end;

procedure TWebInspector.Notification(AComponent: TComponent; Operation: TOperation);
begin
  inherited Notification(AComponent, Operation);
  if (Operation = opRemove) and (AComponent = FWebBrowser) then
    FWebBrowser := nil;
end;

procedure TWebInspector.ViewInspectorClosed;
begin
  if not FClosing then
    FActive := False;
end;

{ A browser creates a new web view each time its window is created, and the
  inspector needs to be shown again for the new web view }

procedure TWebInspector.BrowserNotify(Sender: TObject; Notify: TWebNotify);
begin
  if Notify = wnReady then
    UpdateInspector;
end;

procedure TWebInspector.UpdateInspector;
begin
  if (FWebBrowser = nil) or (not FWebBrowser.HandleAllocated) or (not HandleAllocated) then
    Exit;
  if FActive then
  begin
    FWebBrowser.DeveloperTools := True;
    TWSWebInspector.Open(Self, FWebBrowser);
  end
  else
    CloseInspector;
end;

procedure TWebInspector.CloseInspector;
begin
  if (FWebBrowser = nil) or (not FWebBrowser.HandleAllocated) or (not HandleAllocated) then
    Exit;
  FClosing := True;
  try
    TWSWebInspector.Close(Self, FWebBrowser);
  finally
    FClosing := False;
  end;
end;

procedure TWebInspector.SetActive(Value: Boolean);
begin
  if Value = FActive then
    Exit;
  FActive := Value;
  UpdateInspector;
end;

procedure TWebInspector.SetWebBrowser(Value: TCustomWebBrowser);
begin
  if Value = FWebBrowser then
    Exit;
  if FWebBrowser <> nil then
  begin
    CloseInspector;
    FWebBrowser.RemoveListener(BrowserNotify);
    if FWebBrowser.FInspector = Self then
      FWebBrowser.SetInspector(nil);
    FWebBrowser.RemoveFreeNotification(Self);
  end;
  FWebBrowser := Value;
  if FWebBrowser <> nil then
  begin
    FWebBrowser.FreeNotification(Self);
    FWebBrowser.SetInspector(Self);
    FWebBrowser.AddListener(BrowserNotify);
    UpdateInspector;
  end;
end;

finalization
  Logo.Free;
end.
