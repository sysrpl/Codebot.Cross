procedure TCustomWebBrowser.CancelDownload(Download: TWebDownload);
begin
  if (Download <> nil) and (Download.FStatus = dsActive) then
    TWSWebBrowser.CancelDownload(Download.FHandle);
end;

procedure TCustomWebBrowser.ClearDownloads;
var
  Item: TWebDownload;
  I: Integer;
begin
  for I := FDownloads.Count - 1 downto 0 do
  begin
    Item := TWebDownload(FDownloads[I]);
    if Item.FStatus <> dsActive then
    begin
      FDownloads.Delete(I);
      Item.Free;
    end;
  end;
  Notify(wnDownload);
end;

function TCustomWebBrowser.ActiveDownloadFolder: string;
begin
  Result := FDownloadFolder;
  if (Result = '') and Available then
    Result := TWSWebBrowser.DownloadFolder;
  if Result = '' then
    Result := GetUserDir + 'Downloads';
end;

function TCustomWebBrowser.GetDownloadCount: Integer;
begin
  Result := FDownloads.Count;
end;

function TCustomWebBrowser.GetDownload(Index: Integer): TWebDownload;
begin
  Result := TWebDownload(FDownloads[Index]);
end;

function TCustomWebBrowser.FindDownload(Handle: Pointer): TWebDownload;
var
  I: Integer;
begin
  for I := FDownloads.Count - 1 downto 0 do
  begin
    Result := TWebDownload(FDownloads[I]);
    if Result.FHandle = Handle then
      Exit;
  end;
  Result := nil;
end;

{ A file is not written over an existing file. A number is added to its name
  until the name is not in use. }

function UniqueFileName(const FileName: string): string;
var
  Path, Ext: string;
  I: Integer;
begin
  Result := FileName;
  if not FileExists(Result) then
    Exit;
  Ext := ExtractFileExt(FileName);
  Path := Copy(FileName, 1, Length(FileName) - Length(Ext));
  I := 1;
  repeat
    Result := Path + ' (' + IntToStr(I) + ')' + Ext;
    Inc(I);
  until not FileExists(Result);
end;

procedure TCustomWebBrowser.ViewDownloadStart(Download: Pointer; const Uri: string;
  var FileName: string; var Allow: Boolean);
var
  Item: TWebDownload;
  S: string;
begin
  if csDestroying in ComponentState then
  begin
    Allow := False;
    Exit;
  end;
  S := ExtractFileName(FileName);
  if S = '' then
    S := 'download';
  FileName := UniqueFileName(IncludeTrailingPathDelimiter(ActiveDownloadFolder) + S);
  if Assigned(FOnDownloadStart) then
    FOnDownloadStart(Self, Uri, FileName, Allow);
  if (not Allow) or (FileName = '') then
  begin
    Allow := False;
    Exit;
  end;
  ForceDirectories(ExtractFileDir(FileName));
  Item := TWebDownload.Create;
  Item.FHandle := Download;
  Item.FUri := Uri;
  Item.FFileName := FileName;
  FDownloads.Add(Item);
  Notify(wnDownload);
end;

procedure TCustomWebBrowser.ViewDownloadProgress(Download: Pointer; Progress: Integer);
var
  Item: TWebDownload;
begin
  if csDestroying in ComponentState then
    Exit;
  Item := FindDownload(Download);
  if (Item = nil) or (Item.FProgress = Progress) then
    Exit;
  Item.FProgress := Progress;
  Notify(wnDownload);
  if Assigned(FOnDownloadProgress) then
    FOnDownloadProgress(Self, Item);
end;

{ A download which fails is reported as failed and then as finished. The
  download is released after it finishes, so its handle is no longer kept. }

procedure TCustomWebBrowser.ViewDownloadFinish(Download: Pointer; Failed: Boolean;
  const ErrorMessage: string);
var
  Item: TWebDownload;
begin
  if csDestroying in ComponentState then
    Exit;
  Item := FindDownload(Download);
  if Item = nil then
    Exit;
  if Failed then
  begin
    Item.FStatus := dsFailed;
    Item.FErrorMessage := ErrorMessage;
    Exit;
  end;
  Item.FHandle := nil;
  if Item.FStatus = dsActive then
  begin
    Item.FStatus := dsFinished;
    Item.FProgress := 100;
  end;
  Notify(wnDownload);
  if Assigned(FOnDownloadFinish) then
    FOnDownloadFinish(Self, Item);
end;

{ Inspect Element in the context menu opens the inspector. When the browser
  has an inspector control the inspector is shown in it, rather than in a
  window of its own. The control is shown after the request returns. }

procedure TCustomWebBrowser.ViewInspectorRequest(var Hosted: Boolean);
begin
  if (csDestroying in ComponentState) or (FInspector = nil) then
    Exit;
  Hosted := True;
  Application.QueueAsyncCall(InspectorRequestAsync, 0);
end;

{ The inspector control and any hidden containers holding it, such as a
  caption box, are shown before the inspector is made active }

procedure TCustomWebBrowser.InspectorRequestAsync(Data: PtrInt);
var
  Control: TControl;
begin
  if (csDestroying in ComponentState) or (FInspector = nil) then
    Exit;
  Control := FInspector;
  while (Control <> nil) and not (Control is TCustomForm) do
  begin
    Control.Visible := True;
    Control := Control.Parent;
  end;
  if FInspector.Active then
    FInspector.UpdateInspector
  else
    FInspector.Active := True;
end;

{ An inspector control sets itself as the inspector of the browser it is
  associated with. The two are joined by a free notification, so the browser
  is told if the inspector is destroyed. }

procedure TCustomWebBrowser.SetInspector(Value: TWebInspector);
begin
  FInspector := Value;
  if FInspector <> nil then
    FInspector.FreeNotification(Self);
end;

procedure TCustomWebBrowser.Notification(AComponent: TComponent; Operation: TOperation);
begin
  inherited Notification(AComponent, Operation);
  if (Operation = opRemove) and (AComponent = FInspector) then
    FInspector := nil;
end;

