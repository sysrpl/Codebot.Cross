procedure TCustomWebBrowser.DoScriptDialog(Dialog: TWebScriptDialog;
  const Message: string; var Input: string; var Accepted: Boolean);
var
  Handled: Boolean;
begin
  Accepted := False;
  if csDestroying in ComponentState then
    Exit;
  Handled := False;
  if Assigned(FOnScriptDialog) then
    FOnScriptDialog(Self, Dialog, Message, Input, Accepted, Handled);
  if Handled then
    Exit;
  Accepted := True;
  case Dialog of
    sdAlert: MessageDlg('Alert', Message, mtInformation, [mbOK], 0);
    sdConfirm: Accepted := MessageDlg('Confirmation', Message, mtConfirmation,
      [mbYes, mbNo], 0) = mrYes;
    sdPrompt: Accepted := InputQuery('Prompt', Message, Input);
  end;
end;

{ TCustomWebBrowser normal methods }

procedure TCustomWebBrowser.Load(const Uri: string);
const
  Protocols: array[0..3] of string = ('http://', 'https://', 'file://', 'about:');
var
  Found: Boolean;
  S, L: string;
  I: Integer;
begin
  S := Trim(Uri);
  if S = '' then
    S := 'about:blank';
  L := LowerCase(S);
  Found := False;
  for I := Low(Protocols) to High(Protocols) do
    if Pos(Protocols[I], L) = 1 then
    begin
      Found := True;
      Break;
    end;
  if not Found then
    S := 'https://' + S;
  FHtmlDefined := False;
  if HandleAllocated then
    TWSWebBrowser.Load(Self, S);
  if S <> FLocation then
  begin
    FLocation := S;
    Notify(wnLocation);
    if Assigned(FOnLocationChange) then
      FOnLocationChange(Self);
  end;
end;

