<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="6">
    <Name Value="codebot_render_sdl"/>
    <Type Value="RunAndDesignTime"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="../codebot_render"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Conditionals Value="// On macOS the library of this package, when it is a dynamic package, is
// linked with SDL2_image and needs the shared libs folder of Codebot to
// find it, and a run path to load it. Programs get the same run path from
// codebot_render.
if TargetOS = 'darwin' then begin
  LibraryPath += ';$PkgDir(codebot_render)../../shared/libs/$(TargetCPU)-$(TargetOS)';
  UsageLinkerOptions += ' -rpath $PkgDir(codebot_render)../../shared/libs/$(TargetCPU)-$(TargetOS)';
end;"/>
      <Other>
        <CompilerMessages>
          <IgnoredMessages idx5091="True" idx5024="True"/>
        </CompilerMessages>
      </Other>
    </CompilerOptions>
    <Files>
      <Item>
        <Filename Value="codebot.render.application.pas"/>
        <UnitName Value="Codebot.Render.Application"/>
      </Item>
      <Item>
        <Filename Value="codebot.platform.sdl.pas"/>
        <UnitName Value="Codebot.Platform.SDL"/>
      </Item>
      <Item>
        <Filename Value="codebotrendersdlpackage.pas"/>
        <Type Value="Main Unit"/>
        <UnitName Value="CodebotRenderSdlPackage"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="codebot_render"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
