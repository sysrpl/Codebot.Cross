  object PackageSaveDialog: TSaveDialog
    Title = 'New Package'
    DefaultExt = '.lpk'
    Filter = 'Lazarus packages (*.lpk)|*.lpk'
    Options = [ofPathMustExist, ofEnableSizing, ofViewDetail]
